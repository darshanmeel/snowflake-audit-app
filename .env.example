# Copy to .env and fill in the values. Used by the export (tools/first_run.py, Refresh in the app),
# the only step that talks to Snowflake.
# .env is git-ignored. Never commit it or paste its contents anywhere. There is no password or
# token flag anywhere in this repo by design.
#
# No quotes, no spaces around the '='.

# Account identifier: <orgname>-<account_name>, or the account locator with its region.
#   e.g. myorg-myaccount   or   xy12345.eu-central-1
SNOWFLAKE_ACCOUNT=myorg-myaccount

# The user the export signs in as (a service user with key-pair authentication).
SNOWFLAKE_USER=AUDIT_USER

# Full path to that user's PKCS8 private key file (.p8). Make the key pair with the openssl commands
# in README, "Make the key pair", then attach the public key with ALTER USER ... SET RSA_PUBLIC_KEY
# (README, "Give it access").
SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8

# Only if the private key is encrypted (the -v2 des3 variant in the README).
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# The read-only role created in README, "Give it access", and the small warehouse it may use.
SNOWFLAKE_ROLE=AUDIT_ROLE
SNOWFLAKE_WAREHOUSE=AUDIT_WH
